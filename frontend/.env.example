# PantryPilot Frontend Environment Variables
# Copy this file to .env.local and fill in values for local development.
# Never commit .env.local or any file containing real secrets.

# URL of the PantryPilot FastAPI backend.
# Default is http://localhost:8000 (or http://localhost:8008 if 8000 is occupied).
NEXT_PUBLIC_API_URL=http://localhost:8000
