# PantryPilot Environment Configuration

# Application Mode: Set to "true" for offline zero-credential hackathon demo
DEMO_MODE=true

# Google Cloud / Vertex AI Settings (Required only in Live Mode)
GOOGLE_CLOUD_PROJECT=pantrypilot-hackathon-2026
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro
VERTEX_AI_API_KEY=

# Firebase / Firestore Settings (Optional: defaults to local in-memory/JSON store in Demo Mode)
FIRESTORE_EMULATOR_HOST=
FIREBASE_PROJECT_ID=pantrypilot-hackathon-2026

# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000

# Security & CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
RATE_LIMIT_PER_MINUTE=60
SECRET_KEY=change-this-in-production-use-secret-manager
